# TaxInvoice AI — Company LAN Backend Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR COMPANY LAN MYSQL CREDENTIALS
# DO NOT COMMIT THE .env FILE TO VERSION CONTROL

# FastAPI Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Company LAN MySQL Database Credentials
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tax_invoice_db
MYSQL_USER=tax_admin
MYSQL_PASSWORD=SecureLanPassword123!

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Configuration (Comma-separated LAN IPs / origins)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
